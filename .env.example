# =============================================================================
# LOCAL DEVELOPMENT VARIABLES
# Safe to fill in for local dev. Copy this file to .env and adjust as needed.
# =============================================================================

# Postgres credentials used by docker-compose.yml AND by DATABASE_URL below.
# Keep them in sync if you change one.
POSTGRES_USER=kolu
POSTGRES_PASSWORD=kolu
POSTGRES_DB=kolu_dev
POSTGRES_PORT=5433

# Prisma connection string (must match the POSTGRES_* values above).
DATABASE_URL="postgresql://kolu:kolu@localhost:5433/kolu_dev?schema=public"

# Base URL of the app, used for building absolute links (e.g. overlay URLs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# PRODUCTION SECRETS (placeholders only — never commit real values)
# None of these are implemented yet. They are listed here so the shape of
# required production config is documented ahead of time. See docs/DECISIONS.md
# and docs/ROADMAP.md for which provider/library will fill each of these in.
# =============================================================================

# Auth: provider not yet selected (see docs/DECISIONS.md). Will be either
# Better Auth or Auth.js session/encryption secret.
# AUTH_SECRET=

# Payment: provider not yet selected (Xendit or Midtrans, see docs/PAYMENT.md).
# Only one of the pairs below will actually be used once decided.
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_WEBHOOK_SECRET=

# Payment webhook signature verification secret (provider-agnostic placeholder).
# PAYMENT_WEBHOOK_SECRET=

# OBS overlay token signing/hashing secret (see docs/SECURITY.md — overlay
# tokens must be high-entropy, rotatable, and distinct from session tokens).
# OVERLAY_TOKEN_SECRET=
